{%- comment -%}
  Zaza Woods Esstisch-Konfigurator — Shopify section (fullscreen iframe)
  ---------------------------------------------------------------------
  Mirror of the Picknick `konfigurator-embed.liquid` — same behaviour
  on desktop AND mobile (defer-and-set src to avoid mobile race condition).

  Setup:
    1. Online Store → Pages → "Add page"  →  Title: «Esstisch Konfigurator»
       (Shopify will generate URL /pages/esstisch-konfigurator).
    2. In the page, choose Template: "page" (or any). Save.
    3. Online Store → Themes → Customize → switch to the Esstisch
       Konfigurator page → Add section → "3D Esstisch Konfigurator"
       (this section). Hide Title/Subtitle if not needed.
    4. The button-snippet on each Esstisch product page links here:
       /pages/esstisch-konfigurator?shape=rectangle&length=240
       → these params are passed straight through to the Railway URL.
{%- endcomment -%}

<style>
  .zw-config-section {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
    box-sizing: border-box;
    overflow-x: hidden;
  }
  .zw-config-wrap {
    width: 100%;
    {% if section.settings.max_width > 0 %}max-width: {{ section.settings.max_width }}px; margin: 0 auto;{% endif %}
    {% if section.settings.h_padding > 0 %}padding: 0 {{ section.settings.h_padding }}px; box-sizing: border-box;{% endif %}
  }
  .zw-config-frame {
    display: block;
    width: 100%;
    height: calc(100vh - {{ section.settings.nav_offset }}px);
    height: calc(100dvh - {{ section.settings.nav_offset }}px);
    min-height: 600px;
    border: 0;
    background: #F7F6F3;
    {% if section.settings.radius > 0 %}border-radius: {{ section.settings.radius }}px; overflow: hidden;{% endif %}
  }
  @media (max-width: 860px) {
    .zw-config-frame {
      height: calc(100vh - {{ section.settings.nav_offset_mobile }}px);
      height: calc(100dvh - {{ section.settings.nav_offset_mobile }}px);
      min-height: 520px;
    }
  }
  .zw-config-title { font-size: 28px; font-weight: 600; margin: 0 0 12px;
    color: #1A1A1A; text-align: {{ section.settings.title_align }}; }
  .zw-config-sub   { font-size: 15px; color: #6B6B6B; margin: 0 0 20px;
    text-align: {{ section.settings.title_align }}; }
</style>

{%- assign cfg_base = 'https://zazawoods-esstisch-konfigurator-production.up.railway.app/' -%}
{%- assign cfg_default_qs = '' -%}

<div class="zw-config-section">
  <div class="zw-config-wrap">
    {%- if section.settings.title != blank -%}
      <h2 class="zw-config-title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="zw-config-sub">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <iframe
      id="zw-esstisch-iframe-{{ section.id }}"
      class="zw-config-frame"
      data-zw-base="{{ cfg_base }}"
      data-zw-default-qs="{{ cfg_default_qs }}"
      title="Zaza Woods Esstisch-Konfigurator"
      referrerpolicy="strict-origin-when-cross-origin"
      allow="camera; xr-spatial-tracking"></iframe>
  </div>
</div>

<script>
(function () {
  // Same defer-and-set pattern as Picknick: pass through URL params from the
  // Shopify page to the iframe AFTER the iframe is in the DOM.
  // Whitelist matches the Esstisch configurator's accepted URL params.
  var WHITELIST = ['shape','length','width','color','edge','leg','powder','material','behandlung','variant','thickness','ar','product'];
  var iframe = document.getElementById('zw-esstisch-iframe-{{ section.id }}');
  if (!iframe) return;

  function setSrcOnce() {
    if (iframe.dataset.zwLoaded === '1') return;
    iframe.dataset.zwLoaded = '1';

    var base = iframe.getAttribute('data-zw-base') || '';
    var defaultQs = iframe.getAttribute('data-zw-default-qs') || '';
    var finalSrc = base + defaultQs;

    try {
      var url = new URL(location.href);
      var picked = [];
      WHITELIST.forEach(function (k) {
        var v = url.searchParams.get(k);
        if (v != null && v !== '') {
          picked.push(encodeURIComponent(k) + '=' + encodeURIComponent(v));
        }
      });
      if (picked.length) finalSrc = base + '?' + picked.join('&');
    } catch (e) {}
    iframe.src = finalSrc;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setSrcOnce, { once: true });
  } else {
    setSrcOnce();
  }
})();

(function () {
  // Fill the viewport exactly: height = window height − real top offset.
  // Works no matter what is shown/hidden above (marquee, banners, header).
  var frame = document.getElementById('zw-esstisch-iframe-{{ section.id }}');
  if (!frame) return;
  function fit() {
    var top = frame.getBoundingClientRect().top + (window.pageYOffset || 0);
    var h = Math.max(420, window.innerHeight - top);
    frame.style.height = h + 'px';
    frame.style.minHeight = '0';
  }
  fit();
  window.addEventListener('resize', fit);
  window.addEventListener('load', fit);
  setTimeout(fit, 300);   // after fonts/announcement bars settle
  setTimeout(fit, 1200);
})();
</script>

{% schema %}
{
  "name": "3D Esstisch Konfigurator",
  "tag": "section",
  "class": "zw-esstisch-config-section",
  "settings": [
    { "type": "header", "content": "Überschrift (standardmäßig aus)" },
    { "type": "text",      "id": "title",        "label": "Titel" },
    { "type": "textarea",  "id": "subtitle",     "label": "Untertitel" },
    { "type": "select",    "id": "title_align",  "label": "Titel-Ausrichtung", "options": [
        { "value": "left",   "label": "Links" },
        { "value": "center", "label": "Zentriert" },
        { "value": "right",  "label": "Rechts" }
      ], "default": "center" },

    { "type": "header", "content": "Größe & Abstände" },
    { "type": "range", "id": "max_width",         "label": "Max. Breite (px, 0 = volle Breite)", "min": 0,   "max": 1800, "step": 20, "default": 0 },
    { "type": "range", "id": "nav_offset",        "label": "Höhe Shopify-Navi Desktop (px)",    "min": 0,   "max": 250,  "step": 5,  "default": 150 },
    { "type": "range", "id": "nav_offset_mobile", "label": "Höhe Shopify-Navi Mobil (px)",      "min": 0,   "max": 200,  "step": 5,  "default": 90 },
    { "type": "range", "id": "padding_top",       "label": "Abstand oben (px)",                  "min": 0,   "max": 120,  "step": 4,  "default": 0 },
    { "type": "range", "id": "padding_bottom",    "label": "Abstand unten (px)",                 "min": 0,   "max": 120,  "step": 4,  "default": 0 },
    { "type": "range", "id": "h_padding",         "label": "Seitenabstand (px)",                 "min": 0,   "max": 60,   "step": 2,  "default": 0 },
    { "type": "range", "id": "radius",            "label": "Eckenradius (px)",                   "min": 0,   "max": 24,   "step": 2,  "default": 0 },
    { "type": "color", "id": "bg_color",          "label": "Hintergrund",                        "default": "#F7F6F3" }
  ],
  "presets": [
    { "name": "3D Esstisch Konfigurator" }
  ]
}
{% endschema %}
